{
  "name": "dns-assistant-workspace",
  "private": true,
  "scripts": {
    "version:sync": "node scripts/version.cjs --write",
    "version:check": "node scripts/version.cjs",
    "test:version": "node --test scripts/version.test.cjs",
    "build": "npm --prefix web run build",
    "test:web": "npm --prefix web run test",
    "dev": "npm --prefix web run dev",
    "dev:website": "node web/node_modules/vite/bin/vite.js website --host 127.0.0.1",
    "build:website": "node web/node_modules/vite/bin/vite.js build website --outDir ../artifacts/website --emptyOutDir --base ./",
    "test:website": "node scripts/website-check.cjs"
  },
  "version": "0.4.0"
}
